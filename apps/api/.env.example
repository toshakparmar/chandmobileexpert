# =============================================================================
# Chand Mobile Expert - Backend API (.env.example)
# =============================================================================

# Server Environment & Port
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL / Supabase Transaction Pooler)
# Replace placeholder with your real production PostgreSQL credentials
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# JWT Secret Key (Generate with: openssl rand -base64 32)
JWT_SECRET="cme_super_secret_jwt_key_change_in_production_min32chars"
JWT_EXPIRATION="7d"

# Firebase Admin Service Account (Base64 JSON string or path)
# Required for verifying client Firebase ID tokens
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Direct UPI Payment Gateway Configuration (No intermediary gateway)
# Customer payments transfer directly to this Merchant VPA
UPI_VPA="chandmobile@upi"
UPI_PAYEE_NAME="Chand Mobile Expert"
UPI_QR_EXPIRY_MINUTES=15

# Security & CORS Origins (Comma-separated)
CORS_ORIGIN="http://localhost:3001,http://localhost:3002,https://chandmobileexpert.in,https://admin.chandmobileexpert.in"

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Sandbox / Testing Auth Flag (NEVER enable in production)
ALLOW_TEST_AUTH=false

