# =============================================================================
# Chand Mobile Expert - Admin Panel (.env.example)
# =============================================================================

# NestJS Backend API Endpoint (Standardized across all apps)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Admin Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# Firebase Client Web Config (Admin Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="chandmobileexpert.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="chandmobileexpert"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="chandmobileexpert.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

